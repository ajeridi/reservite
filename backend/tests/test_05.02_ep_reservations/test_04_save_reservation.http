### creation d'une nouvelle reservation par un client
POST http://localhost:3000/rpc/save_reservation
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiY2xpZW50Iiwic3ViIjoiYnJsYWNyb2l4QGVwZmMuZXUiLCJuYW1lIjoiQnJ1bm8iLCJ1c2VyX2lkIjo2LCJleHAiOjE3Nzk1NDMzMTZ9.jkzlLyOXQ2D3uVtbeF0s2YjMxSDV81kVMcBIoe6g6Uw

{
  "restaurant_id" : 3,
  "datetime_" : "2024-12-06 18:30:00",
  "number_of_guests_" : 2,
  "special_requests_" : "xxxxxxxxxxxxxxxxxxxx"
}

